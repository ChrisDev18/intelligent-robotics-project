<?xml version="1.0"?>
<robot name="turtlebot3_manipulation" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="prefix" default="" />
  <xacro:arg name="use_sim" default="true" />
  <xacro:arg name="use_fake_hardware" default="false" />
  <xacro:arg name="fake_sensor_commands" default="false" />

  <!-- Include official ROBOTIS TurtleBot3 Manipulation materials and URDF macros -->
  <xacro:include filename="$(find turtlebot3_manipulation_description)/urdf/materials.xacro" />
  <xacro:include filename="$(find turtlebot3_manipulation_description)/urdf/turtlebot3_waffle_pi.urdf.xacro" />
  <xacro:include filename="$(find turtlebot3_manipulation_description)/urdf/open_manipulator_x.urdf.xacro" />

  <!-- Include custom Gazebo Harmonic sensors/plugins and ros2_control configuration -->
  <xacro:include filename="$(find robot_bringup)/urdf/turtlebot3_manipulation_gz.xacro" />
  <xacro:include filename="$(find robot_bringup)/urdf/turtlebot3_manipulation.ros2_control.xacro" />

  <!-- Instantiate TurtleBot3 Waffle Pi mobile base (includes 2D LiDAR base_scan, imu_link, wheels) -->
  <xacro:turtlebot3_waffle_pi prefix="$(arg prefix)" />

  <!-- Mount OpenManipulator-X 4-DOF arm + parallel-jaw gripper onto TurtleBot3 Waffle Pi base -->
  <joint name="$(arg prefix)base_fixed" type="fixed">
    <parent link="$(arg prefix)base_link" />
    <child link="$(arg prefix)link1" />
    <origin xyz="-0.092 0.0 0.091" rpy="0 0 0" />
  </joint>

  <xacro:open_manipulator_x prefix="$(arg prefix)" />

  <!-- Front-mounted RGB-D Camera for Room Color Recognition (Blue/Green) and Object Detection -->
  <joint name="$(arg prefix)rgbd_camera_joint" type="fixed">
    <parent link="$(arg prefix)base_link" />
    <child link="$(arg prefix)rgbd_camera_link" />
    <origin xyz="0.073 0.0 0.084" rpy="0 0 0" />
  </joint>

  <link name="$(arg prefix)rgbd_camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.025 0.090 0.025" />
      </geometry>
      <material name="dark" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.025 0.090 0.025" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.035" />
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
    </inertial>
  </link>

  <joint name="$(arg prefix)rgbd_camera_optical_joint" type="fixed">
    <parent link="$(arg prefix)rgbd_camera_link" />
    <child link="$(arg prefix)rgbd_camera_optical_frame" />
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
  </joint>
  <link name="$(arg prefix)rgbd_camera_optical_frame" />

  <!-- Configure Gazebo Harmonic physics, sensors, and plugins -->
  <xacro:turtlebot3_manipulation_gz prefix="$(arg prefix)" />

  <!-- Configure ros2_control for OpenManipulator-X arm and parallel-jaw gripper -->
  <xacro:turtlebot3_manipulation_ros2_control
    name="TurtleBot3ManipulationSystem"
    prefix="$(arg prefix)"
    use_sim="$(arg use_sim)"
    use_fake_hardware="$(arg use_fake_hardware)"
    fake_sensor_commands="$(arg fake_sensor_commands)" />

</robot>
